{
  "schemaVersion": 1,
  "id": "search-page-localization-sample",
  "title": "Search returns page-localized matches on sample PDF",
  "class": "search_localization",
  "status": "active",
  "tool": "search_pdf",
  "fixture": "test/fixtures/sample.pdf",
  "input": {
    "sources": [{ "path": "test/fixtures/sample.pdf" }],
    "query": "PDF",
    "case_sensitive": false,
    "max_pages": 3
  },
  "acceptance": {
    "resultSuccess": true,
    "minMatches": 1,
    "requireMatchPageAtLeast": 1
  },
  "contractIds": ["semantic-search-relevance"]
}
